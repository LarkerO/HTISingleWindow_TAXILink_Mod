{
  "enabled": true,
  "endpoint": "wss://dispatch.example.com/taxilink",
  "sm2PrivateKeyFile": "taxilink-mod-private.pem",
  "sm2GatewayPublicKeyFile": "taxilink-gateway-public.pem",
  "opensslExecutable": "openssl",
  "serverId": "taxilink-01",
  "allowInsecureLocalhost": false,
  "telemetrySeconds": 2,
  "generationTimeoutSeconds": 60,
  "pickupWaitSeconds": 300,
  "fullBoardingCloseDelaySeconds": 5,
  "closedDoorDepartureDelaySeconds": 5,
  "maxActiveRides": 64,
  "queueTimeoutSeconds": 120,
  "maxQueuedRides": 256,
  "maxMessageBytes": 65536,
  "maxPendingCommands": 128
}
